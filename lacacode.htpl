<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>LA CÀ - Tiệm Làm Đẹp Cao Cấp</title>
<meta name="description" content="LA CÀ - Tiệm làm đẹp cao cấp, hiện đại và chuyên nghiệp. Nail, gội đầu, spa thư giãn." />
<style>
  /* Fonts */
  @import url('https://fonts.googleapis.com/css2?family=Lato&family=Playfair+Display&display=swap');

  /* Reset & base */
  *, *::before, *::after { box-sizing: border-box; }
  body {
    margin: 0; font-family: 'Lato', sans-serif;
    background: #fff;
    color: #5a4a3d;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  h1,h2,h3,h4{
    font-family: 'Playfair Display', serif;
    color: #7a6a57;
    margin-top: 0;
  }
  a { text-decoration: none; color: inherit; }
  img {
    max-width: 100%;
    border-radius: 8px;
  }
  button {
    cursor: pointer;
    border: none;
    border-radius: 30px;
    padding: 12px 30px;
    font-weight: 600;
    font-size: 1rem;
    transition: background-color 0.3s ease;
  }
  .btn-primary {
    background-color: #c8a268;
    color: #fff;
  }
  .btn-primary:hover {
    background-color: #b5954f;
  }
  .btn-secondary {
    background-color: #7a6a57;
    color: #fff;
  }
  .btn-secondary:hover {
    background-color: #665840;
  }


  /* MENU */
  header {
    position: fixed;
    width: 100%;
    top: 0; left: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    background: rgba(255 255 255 / 0.8);
    backdrop-filter: saturate(180%) blur(18px);
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.05);
    z-index: 999;
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }
  header.scrolled {
    background: rgba(255 255 255 / 0.95);
    box-shadow: 0 3px 10px rgb(0 0 0 / 0.1);
  }
  .logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    font-weight: 700;
    color: #7a6a57;
    user-select: none;
  }
  nav ul {
    list-style: none;
    display: flex;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }
  nav ul li a {
    position: relative;
    font-weight: 600;
    color: #7a6a57;
  }
  nav ul li a:hover,
  nav ul li a.active {
    color: #c8a268;
  }
  nav ul li a::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -4px;
    height: 2px;
    background-color: #c8a268;
    transform-origin: right;
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }
  nav ul li a:hover::after,
  nav ul li a.active::after {
    transform-origin: left;
    transform: scaleX(1);
  }

  /* HERO */
  #hero {
    height: 100vh;
    background: url('https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1470&q=80') center/cover no-repeat;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 0 2rem;
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  #hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(122,106,87,0.6);
    z-index: 0;
  }
  #hero .content {
    position: relative;
    z-index: 1;
    max-width: 700px;
  }
  #hero .logo-hero {
    font-family: 'Playfair Display', serif;
    font-size: 3rem;
    margin-bottom: 1rem;
    letter-spacing: 6px;
    color: #f8f1e4;
    text-shadow: 0 0 10px rgba(200,162,104,0.5);
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.8s forwards 0.3s;
  }
  #hero h1 {
    font-size: 2.25rem;
    margin: 0 0 0.5rem;
    line-height: 1.2;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.8s forwards 0.6s;
  }
  #hero p {
    font-size: 1.2rem;
    margin-bottom: 2rem;
    font-weight: 300;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.8s forwards 0.9s;
  }
  #hero .buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.8s forwards 1.2s;
  }
  #hero .buttons button {
    min-width: 160px;
  }

  /* INTRO */
  section#intro {
    padding: 6rem 2rem 4rem;
    max-width: 1100px;
    margin: auto;
    display: flex;
    gap: 3rem;
    align-items: center;
    flex-wrap: wrap;
  }
  #intro .intro-text {
    flex: 1 1 400px;
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.6s ease;
  }
  #intro .intro-text.visible {
    opacity: 1;
    transform: translateY(0);
  }
  #intro h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
    color: #7a6a57;
  }
  #intro p {
    font-size: 1.1rem;
    color: #5a4a3d;
    line-height: 1.7;
  }
  #intro img {
    flex: 1 1 400px;
    border-radius: 12px;
    max-height: 350px;
    object-fit: cover;
    opacity: 0;
    transform: translateX(-40px);
    transition: all 0.6s ease;
  }
  #intro img.visible {
    opacity: 1;
    transform: translateX(0);
  }

  /* SERVICES */
  section#services {
    background: #f8f1e4;
    padding: 4rem 2rem 6rem;
    max-width: 1100px;
    margin: auto;
  }
  section#services h2 {
    text-align: center;
    margin-bottom: 3rem;
    color: #7a6a57;
    font-size: 2.2rem;
  }
  .service {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 4rem;
    background: #fff;
    padding: 1.5rem;
    border-radius: 12px;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.05);
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.6s ease;
  }
  .service.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .service:nth-child(even) {
    flex-direction: row-reverse;
  }
  .service img {
    width: 45%;
    border-radius: 12px;
  }
  .service-content {
    width: 55%;
  }
  .service-content h3 {
    font-size: 1.75rem;
    margin-bottom: 1rem;
    color: #7a6a57;
  }
  .service-content p {
    font-size: 1.1rem;
    color: #5a4a3d;
    margin-bottom: 1.5rem;
  }
  .service-content button {
    background-color: #c8a268;
    color: #fff;
    font-weight: 600;
    border-radius: 40px;
    padding: 10px 28px;
    border: none;
    transition: background-color 0.3s ease;
  }
  .service-content button:hover {
    background-color: #b5954f;
  }

  /* GALLERY */
  section#gallery {
    max-width: 1100px;
    margin: auto;
    padding: 4rem 2rem;
  }
  #gallery h2 {
    text-align: center;
    color: #7a6a57;
    font-size: 2.2rem;
    margin-bottom: 2rem;
  }
  .gallery-grid {
    column-count: 3;
    column-gap: 1rem;
  }
  .gallery-item {
    break-inside: avoid;
    margin-bottom: 1rem;
    overflow: hidden;
    border-radius: 12px;
    cursor: pointer;
    position: relative;
    transition: transform 0.3s ease;
  }
  .gallery-item img {
    display: block;
    border-radius: 12px;
    width: 100%;
    object-fit: cover;
    vertical-align: middle;
  }
  .gallery-item:hover {
    transform: scale(1.05);
    z-index: 5;
  }
  /* Lightbox */
  #lightbox {
    position: fixed;
    display: none;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.8);
    justify-content: center;
    align-items: center;
    z-index: 1000;
  }
  #lightbox img {
    max-width: 90%;
    max-height: 90%;
    border-radius: 8px;
    box-shadow: 0 0 20px #fff;
  }

  /* CONTACT */
  section#contact {
    max-width: 1100px;
    margin: auto;
    background: #fff;
    padding: 4rem 2rem 6rem;
    text-align: center;
    color: #5a4a3d;
  }
  #contact h2 {
    font-size: 2.2rem;
    color: #7a6a57;
    margin-bottom: 2rem;
  }
  #contact .info {
    margin-bottom: 2rem;
    font-weight: 500;
    font-size: 1.1rem;
  }
  #contact .phone-buttons {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  #contact .phone-buttons a {
    background: #c8a268;
    color: #fff;
    padding: 12px 24px;
    border-radius: 30px;
    font-weight: 600;
    transition: background-color 0.3s ease;
  }
  #contact .phone-buttons a:hover {
    background: #b5954f;
  }
  #map {
    width: 100%;
    height: 300px;
    border-radius: 12px;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.1);
  }

  /* FOOTER */
  footer {
    background-color: #f8f1e4;
    padding: 2rem;
    text-align: center;
    color: #7a6a57;
  }
  footer .footer-logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  footer p {
    margin: 0.3rem auto;
  }
  footer nav a {
    margin: 0 0.8rem;
    color: #7a6a57;
    font-weight: 600;
    font-size: 0.95rem;
  }
  footer nav a:hover {
    color: #c8a268;
  }

  /* Back to top button */
  #backToTop {
    position: fixed;
    bottom: 30px;
    right: 30px;
    background-color: #c8a268;
    color: white;
    border-radius: 50%;
    width: 45px;
    height: 45px;
    font-size: 24px;
    line-height: 45px;
    text-align: center;
    cursor: pointer;
    display: none;
    z-index: 1100;
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.3);
    transition: background-color 0.3s ease;
  }
  #backToTop:hover {
    background-color: #b5954f;
  }

  /* Phone call fixed button */
  #callNow {
    position: fixed;
    bottom: 100px;
    right: 20px;
    background-color: #c8a268;
    color: #fff;
    border-radius: 50%;
    width: 52px;
    height: 52px;
    font-size: 28px;
    line-height: 52px;
    text-align: center;
    box-shadow: 0 4px 12px rgb(0 0 0 / 0.25);
    cursor: pointer;
    display: none;
    z-index: 1110;
  }
  #callNow:hover {
    background-color: #b5954f;
  }
  /* Show on mobile only */
  @media (max-width: 768px) {
    #callNow {
      display: block;
    }
  }

  /* Responsive */
  @media (max-width: 960px) {
    #intro {
      flex-direction: column;
    }
    .service {
      flex-direction: column !important;
      text-align: center;
    }
    .service img, .service-content {
      width: 100% !important;
    }
    .gallery-grid {
      column-count: 2;
    }
  }
  @media (max-width: 480px) {
    .gallery-grid {
      column-count: 1;
    }
  }

  /* Animations */
  @keyframes fadeInUp {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
</head>
<body>

<header id="header">
  <div class="logo">LA CÀ</div>
  <nav>
    <ul>
      <li><a href="#hero" class="active">Trang chủ</a></li>
      <li><a href="#intro">Giới thiệu</a></li>
      <li><a href="#services">Dịch vụ</a></li>
      <li><a href="#gallery">Thư viện ảnh</a></li>
      <li><a href="#contact">Liên hệ</a></li>
    </ul>
  </nav>
</header>

<section id="hero" aria-label="Trang chủ">
  <div class="content">
    <div class="logo-hero" aria-label="Logo LA CÀ">LA CÀ</div>
    <h1>LA CÀ – Chạm đến vẻ đẹp, tận hưởng sự thư thái</h1>
    <p>Nơi bạn dành thời gian yêu thương và chăm sóc bản thân.</p>
    <div class="buttons">
      <button class="btn-primary" onclick="scrollToSection('#services')">KHÁM PHÁ DỊCH VỤ</button>
      <button class="btn-secondary" onclick="scrollToSection('#contact')">LIÊN HỆ NGAY</button>
    </div>
  </div>
</section>

<section id="intro" aria-label="Giới thiệu">
  <div class="intro-text">
    <h2>CHÀO MỪNG ĐẾN VỚI LA CÀ</h2>
    <p>La Cà là không gian làm đẹp và thư giãn dành cho những ai muốn dành thời gian chăm sóc bản thân. Chúng tôi mang đến các dịch vụ làm đẹp, chăm sóc móng, gội đầu và spa trong một không gian nhẹ nhàng, tinh tế và thoải mái.</p>
  </div>
  <img src="https://images.unsplash.com/photo-1549924231-f129b911e442?auto=format&fit=crop&w=800&q=60" alt="Không gian spa LA CÀ sang trọng" />
</section>

<section id="services" aria-label="Dịch vụ">
  <h2>Dịch vụ của chúng tôi</h2>

  <article class="service" data-index="1">
    <img src="https://images.unsplash.com/photo-1501630834273-4b5604d2ee31?auto=format&fit=crop&w=700&q=60" alt="Móng tay với thiết kế nghệ thuật" />
    <div class="service-content">
      <h3>NAIL – VẺ ĐẸP TỪ NHỮNG CHI TIẾT NHỎ</h3>
      <p>Chăm sóc móng, sơn gel, thiết kế nail nghệ thuật và làm đẹp đôi bàn tay.</p>
      <button onclick="alert('Khám phá dịch vụ Nail')">KHÁM PHÁ</button>
    </div>
  </article>

  <article class="service" data-index="2">
    <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=700&q=60" alt="Gội đầu thư giãn trong không gian sang trọng" />
    <div class="service-content">
      <h3>GỘI ĐẦU – THƯ GIÃN TỪNG KHOẢNH KHẮC</h3>
      <p>Mang đến cảm giác thư thái với dịch vụ gội đầu và chăm sóc tóc nhẹ nhàng.</p>
      <button onclick="alert('Khám phá dịch vụ Gội đầu')">KHÁM PHÁ</button>
    </div>
  </article>

  <article class="service" data-index="3">
    <img src="https://images.unsplash.com/photo-1556228724-4f343c7ef585?auto=format&fit=crop&w=700&q=60" alt="Không gian spa chăm sóc da và thư giãn" />
    <div class="service-content">
      <h3>SPA – YÊU CHIỀU BẢN THÂN</h3>
      <p>Không gian chăm sóc và thư giãn giúp bạn tận hưởng những phút giây nghỉ ngơi.</p>
      <button onclick="alert('Khám phá dịch vụ Spa')">KHÁM PHÁ</button>
    </div>
  </article>
</section>

<section id="gallery" aria-label="Thư viện ảnh">
  <h2>KHÔNG GIAN CỦA LA CÀ</h2>
  <div class="gallery-grid">
    <div class="gallery-item">
      <img src="https://images.unsplash.com/photo-1526045612212-70caf35c14df?auto=format&fit=crop&w=600&q=60" alt="Không gian tiệm LA CÀ" />
    </div>
    <div class="gallery-item">
      <img src="https://images.unsplash.com/photo-1501139083538-0139583c060f?auto=format&fit=crop&w=600&q=60" alt="Làm móng nghệ thuật tại LA CÀ" />
    </div>
    <div class="gallery-item">
      <img src="https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?auto=format&fit=crop&w=600&q=60" alt="Gội đầu thư giãn" />
    </div>
    <div class="gallery-item">
      <img src="https://images.unsplash.com/photo-1504384308090-c894fdcc538d?auto=format&fit=crop&w=600&q=60" alt="Chăm sóc spa thư giãn" />
    </div>
    <div class="gallery-item">
      <img src="https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?auto=format&fit=crop&w=600&q=60" alt="Gội đầu thư giãn" />
    </div>
    <div class="gallery-item">
      <img src="https://images.unsplash.com/photo-1526045612212-70caf35c14df?auto=format&fit=crop&w=600&q=60" alt="Không gian tiệm LA CÀ" />
    </div>
  </div>
</section>

<div id="lightbox" aria-modal="true" role="dialog" tabindex="-1">
  <img src="#" alt="Ảnh lớn hiển thị"/>
</div>

<section id="contact" aria-label="Liên hệ">
  <h2>LA CÀ LUÔN CHÀO ĐÓN BẠN</h2>
  <div class="info">
    <p><strong>Tên tiệm:</strong> LA CÀ</p>
    <p><strong>Số điện thoại:</strong> 0982243924 | 0379992744</p>
    <p><strong>Địa chỉ:</strong> 108E Lê Thánh Tôn, TP. HCM</p>
  </div>
  <div class="phone-buttons">
    <a href="tel:0982243924" aria-label="Gọi ngay số 0982243924">GỌI NGAY: 0982243924</a>
    <a href="tel:0379992744" aria-label="Gọi ngay số 0379992744">GỌI NGAY: 0379992744</a>
  </div>
  <div id="map" role="img" aria-label="Bản đồ Google Maps địa chỉ LA CÀ"></div>
</section>

<footer>
  <div class="footer-logo">LA CÀ</div>
  <p>Đẹp hơn mỗi ngày, thư giãn theo cách riêng.</p>
  <p>📞 0982243924 | 0379992744</p>
  <p>📍 108E Lê Thánh Tôn, TP. HCM</p>
  <nav>
    <a href="#hero">Trang chủ</a>
    <a href="#intro">Giới thiệu</a>
    <a href="#services">Dịch vụ</a>
    <a href="#gallery">Thư viện ảnh</a>
    <a href="#contact">Liên hệ</a>
  </nav>
  <p>© 2026 LA CÀ. All Rights Reserved.</p>
</footer>

<div id="backToTop" aria-label="Quay lại đầu trang" role="button" tabindex="0" title="Back to top">&#8679;</div>
<div id="callNow" aria-label="Gọi điện thoại" role="button" tabindex="0" title="Gọi điện thoại">&#128222;</div>

<script>
  // Smooth scroll navigation
  const navLinks = document.querySelectorAll('nav ul li a');
  navLinks.forEach(link => {
    link.addEventListener('click', e => {
      e.preventDefault();
      document.querySelectorAll('nav ul li a').forEach(l => l.classList.remove('active'));
      link.classList.add('active');
      document.querySelector(link.getAttribute('href')).scrollIntoView({behavior: 'smooth'});
    });
  });

  function scrollToSection(selector) {
    document.querySelector(selector).scrollIntoView({behavior:'smooth'});
  }

  // Header background on scroll
  const header = document.getElementById('header');
  window.addEventListener('scroll', () => {
    if(window.scrollY > 50){
      header.classList.add('scrolled');
    } else {
      header.classList.remove('scrolled');
    }
    // Show back to top button
    const backToTop = document.getElementById('backToTop');
    if(window.scrollY > 300){
      backToTop.style.display = 'block';
    } else {
      backToTop.style.display = 'none';
    }
  });

  // Back to top button
  document.getElementById('backToTop').addEventListener('click', () => {
    window.scrollTo({top:0, behavior:'smooth'});
  });

  // Call now button opens dialer with first phone number
  document.getElementById('callNow').addEventListener('click', () => {
    window.location.href = "tel:0982243924";
  });

  // Intersection Observer for fade in/slide animations
  const options = {
    threshold: 0.1
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if(entry.isIntersecting){
        entry.target.classList.add('visible');
      } else {
        // To allow re-triggering when scrolling up
        entry.target.classList.remove('visible');
      }
    });
  }, options);

  // Observe intro text and image
  const introElements = document.querySelectorAll('#intro .intro-text, #intro img');
  introElements.forEach(el => observer.observe(el));

  // Observe each service
  const services = document.querySelectorAll('.service');
  services.forEach(service => observer.observe(service));

  // Gallery Lightbox
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = lightbox.querySelector('img');
  const galleryItems = document.querySelectorAll('.gallery-item img');

  galleryItems.forEach(item => {
    item.addEventListener('click', () => {
      lightbox.style.display = 'flex';
      lightboxImg.src = item.src;
      lightboxImg.alt = item.alt;
      document.body.style.overflow = 'hidden'; // Disable scroll when lightbox open
    });
  });
  lightbox.addEventListener('click', (e) => {
    if(e.target !== lightboxImg){
      lightbox.style.display = 'none';
      document.body.style.overflow = '';
    }
  });

</script>
<script async src="https://maps.googleapis.com/maps/api/js?key=YOUR_API_KEY&callback=initMap"></script>
<script>
  // Initialize Google Map
  function initMap() {
    const location = { lat: 10.7769, lng: 106.7009 }; // Approximate coords for 108E Lê Thánh Tôn
    const map = new google.maps.Map(document.getElementById('map'), {
      zoom: 16,
      center: location,
      disableDefaultUI: true,
      styles: [
        {
          elementType: 'geometry',
          stylers: [{color: '#f5f1e6'}]
        },
        {
          elementType: 'labels.text.fill',
          stylers: [{color: '#7a6a57'}]
        },
        {
          elementType: 'labels.text.stroke',
          stylers: [{color: '#fefefe'}]
        },
        {
          featureType: 'poi',
          elementType: 'geometry',
          stylers: [{color: '#dcd2be'}]
        }
      ]
    });
    const marker = new google.maps.Marker({
      position: location,
      map: map,
      title: 'LA CÀ - 108E Lê Thánh Tôn'
    });
  }
</script>

</body>
</html>
